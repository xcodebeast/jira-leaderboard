{
	"name": "jira-leaderboard",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.9",
	"scripts": {
		"build": "vite build",
		"check": "bun run check:quality && bun run check:types && bun test",
		"check:quality": "biome check .",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:write": "biome check --write .",
		"dev": "vite dev",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"start": "bun build/index.js",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.3.14",
		"@types/node": "26.2.0",
		"svelte": "5.56.9",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.2.1"
	}
}
