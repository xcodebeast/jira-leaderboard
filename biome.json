{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 1000
					}
				},
				"useNamingConvention": {
					"level": "error",
					"options": {
						"conventions": [
							{
								"selector": {
									"kind": "any"
								},
								"match": "(.{3,})"
							}
						]
					}
				}
			},
			"complexity": {
				"preset": "recommended"
			},
			"correctness": {
				"preset": "recommended"
			},
			"security": {
				"preset": "recommended"
			},
			"suspicious": {
				"preset": "recommended"
			},
			"performance": {
				"preset": "recommended"
			},
			"a11y": {
				"preset": "recommended"
			},
			"nursery": {
				"preset": "recommended"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"preset": "recommended"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
